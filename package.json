{
  "name": "personal-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "个人工作生活台 · 本地运行",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs --no-open\" \"vite\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
